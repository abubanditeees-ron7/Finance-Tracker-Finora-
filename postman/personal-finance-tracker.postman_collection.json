        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"postman_test@example.com\",\n  \"code\": \"REPLACE_WITH_EMAIL_CODE\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/verify-email/"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('access', data.access);",
              "  pm.collectionVariables.set('refresh', data.refresh);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_test\",\n  \"password\": \"StrongPass123!Example\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login/"
      }
    },
    {
      "name": "Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('access', pm.response.json().access);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/token/refresh/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access}}",
              "type": "string"
            }
          ]
        }
      }
    },
