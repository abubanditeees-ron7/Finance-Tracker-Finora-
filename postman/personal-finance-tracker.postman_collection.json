      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_test\",\n  \"email\": \"postman_test@example.com\",\n  \"password\": \"StrongPass123!Example\",\n  \"password_confirm\": \"StrongPass123!Example\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register/"
      }
    },
    {
      "name": "Verify Email",
      "request": {
        "method": "POST",
